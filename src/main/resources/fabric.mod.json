{
	"schemaVersion": 1,
	"id": "cubism",
	"version": "${version}",
	"name": "Cubism",
	"description": "Makes the overworld one cube planet that floats in empty space.",
	"authors": [
		"Coolpick"
	],
	"contact": {
		"homepage": "https://github.com/CoolpickB/Cubism",
		"sources": "https://github.com/CoolpickB/Cubism",
		"issues": "https://github.com/CoolpickB/Cubism/issues"
	},
	"license": "MIT",
	"icon": "assets/cubism/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.cubism.CubismMod"
		],
		"client": [
			"dev.cubism.client.CubismClient"
		]
	},
	"mixins": [
		"cubism.mixins.json",
		"cubism.compat.voxyworldgenv3.mixins.json",
		{
			"config": "cubism.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "cubism.compat.sodium.mixins.json",
			"environment": "client"
		},
		{
			"config": "cubism.compat.iris.mixins.json",
			"environment": "client"
		},
		{
			"config": "cubism.compat.voxy.mixins.json",
			"environment": "client"
		},
		{
			"config": "cubism.compat.entityculling.mixins.json",
			"environment": "client"
		},
		{
			"config": "cubism.compat.xaerominimap.mixins.json",
			"environment": "client"
		},
		{
			"config": "cubism.compat.xaeroworldmap.mixins.json",
			"environment": "client"
		}
	],
	"custom": {
		"lithium:options": {
			"mixin.entity.collisions.movement": false,
			"mixin.entity.collisions.intersection": false,
			"mixin.minimal_nonvanilla.collisions.empty_space": false,
			"mixin.experimental.entity.block_caching.block_support": false
		}
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
